generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FAN
  CREATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// STABLE/ETH are settlement assets fans deposit in; ONLYONE is the platform
// token, which is never a payment (see core/ledger.ts's Balance type).
//
// STABLE is deliberately not a specific ticker. Robinhood Chain's dollar
// stablecoin is USDG today, USDC has no contract there, and which dollar
// tokens exist on a chain changes. Every one of them is worth a dollar, so
// the ledger does not need to care which arrived -- it books cents. The
// symbol is kept on the Deposit row for the audit trail, and which contracts
// are accepted is configuration (lib/chain.ts STABLECOINS), not code.
enum Asset {
  STABLE
  ETH
  ONLYONE
}

enum TxType {
  DEPOSIT
  SUBSCRIPTION
  PPV
  TIP
  MESSAGE_UNLOCK
  LIVE_TICKET
  // Live revenue, kept as its own types so the 20% rate is a property of the
  // ledger row rather than something you have to re-derive from a stream
  // that has since ended. See PLATFORM_BPS_BY_TYPE in core/ledger.ts.
  LIVE_MINUTE
  LIVE_TIP
  // A fan paying a creator to land a message in their inbox. Standard 10%:
  // the money is the creator's earnings, not a platform toll.
  DM_SEND
  PAYOUT
  PAYOUT_REVERSAL
  PLATFORM_FEE
  REFERRAL
  ADJUSTMENT
  TOKEN_LOCK
  MARKETPLACE_SALE
  REFUND
  AUCTION_BID_HOLD
  AUCTION_BID_RELEASE
  TOKEN_BURN
}

enum SaleType {
  FIXED
  AUCTION
}

enum ListingKind {
  DIGITAL
  PHYSICAL
}

enum ShipStatus {
  DIGITAL // instant -- unlocking the media IS delivery
  AWAITING_SHIPMENT
  SHIPPED
}

enum ListingStatus {
  ACTIVE
  SOLD
  REMOVED
}

enum SubStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum Visibility {
  PUBLIC
  SUBSCRIBERS
  PPV
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  REJECTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SENT
  // Needs an admin: the transaction's fate could not be settled automatically
  // (its txHash is kept). Resolve with POST /admin/payouts/:id/resolve.
  FAILED
  // Not signed because the creator was frozen, suspended or banned when it
  // came up (workers/payout-worker.ts). The money stays reserved -- never
  // handed back automatically to someone just banned -- until an admin
  // releases (sends) or refunds it.
  HELD
  // Reversed: the gross went back to the creator (as withdrawable earnings)
  // and the fee back out of platform revenue, with its burn obligation.
  REFUNDED
}

enum StreamStatus {
  LIVE
  ENDED
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  role         Role       @default(FAN)
  status       UserStatus @default(ACTIVE)
  // Nullable: real accounts created via POST /register always have one (age-
  // gated there, see modules/auth.ts). Accounts auto-provisioned through the
  // bridge from the Next.js site do not -- that site never collects a DOB at
  // signup (self-reported 18+ checkbox + AgeChecker.Net only), and inventing
  // one here would be fabricating exactly the kind of compliance-relevant
  // fact this codebase has repeatedly refused to fake elsewhere (see
  // MEMORY.md: sanitizeAge throws rather than guessing, the §2257 custodian
  // address was never invented). Nothing outside modules/auth.ts's own
  // /register route reads this field.
  dob          DateTime?
  // The Next.js site's own user id for an account provisioned through
  // POST /auth/bridge -- the ONLY key the bridge ever joins on. Email is not
  // an identity here: neither system verifies that anyone owns an address,
  // so joining on it let whoever created a row for an email first own every
  // later bridged session for it (and 'treasury@internal' bridged straight
  // into the platform ADMIN account). Null for native (/register) rows and
  // system accounts, which the bridge therefore can never reach.
  siteUid      String?    @unique
  // The site creator's standing as last seen by the bridge (lib/bridge.ts):
  // 'active' | 'pending' | 'suspended' | 'banned', null for fans and native
  // rows. app.creatorOk requires 'active' for a bridged row -- the site's
  // approval (with its §2257 gate) is the platform's creator approval.
  siteCreatorStatus String?
  // True when `status` was set by the site's standing (bridge exchange or
  // status push) rather than by an admin here. Only a site-set suspension
  // is lifted by the site reporting the creator active again.
  statusBySite Boolean @default(false)
  // When the site decided the last standing applied to this row (the
  // `standingAt` stamp on a bridge exchange or status push, lib/bridge.ts
  // claimStanding). Orders site standing messages: one older than this is
  // ignored, so a stale 'active' cannot lift a newer suspension.
  siteStatusAt DateTime?
  // The same two facts for the OTHER standing the site keeps on an account:
  // its account (user-moderation) standing -- 'active' | 'suspended' |
  // 'banned', sent as a FAN-role message -- and when the site decided it.
  // Kept apart from siteCreatorStatus/siteStatusAt so each is ordered on its
  // own clock, and so 'active' in one never lifts a suspension the other
  // still holds (lib/bridge.ts siteMayLift).
  siteAccountStatus   String?
  siteAccountStatusAt DateTime?
  // When a site-applied suspension lapses by itself, per dimension (the
  // site's `suspendedUntil`): creator ladder / account moderation. Null
  // unless that dimension's recorded site standing is 'suspended' with an
  // end. lib/bridge.ts liftLapsedSiteSuspensions lifts it once passed.
  siteSuspendedUntil        DateTime?
  siteAccountSuspendedUntil DateTime?
  kycStatus    KycStatus  @default(NONE)
  kycRef       String? // provider applicant id (2257-adjacent record pointer)
  referredById String?
  referredBy   User?      @relation("Referral", fields: [referredById], references: [id])
  referrals    User[]     @relation("Referral")
  createdAt    DateTime   @default(now())

  creator        CreatorProfile?
  notifications  Notification[]
  account        Account?
  ledger         LedgerEntry[]
  refreshTokens  RefreshToken[]
  depositAddrs   DepositAddress[]
  subsAsFan      Subscription[]   @relation("FanSubs")
  subsAsCreator  Subscription[]   @relation("CreatorSubs")
  locksAsFan     TokenLock[]      @relation("FanLocks")
  locksAsCreator TokenLock[]      @relation("CreatorLocks")
  purchases      ListingOrder[]
  bids           Bid[]

  @@index([siteSuspendedUntil])
  @@index([siteAccountSuspendedUntil])
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
}

model CreatorProfile {
  userId              String    @id
  user                User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName         String
  bio                 String    @default("")
  // Where to email this creator when something needs their attention.
  // Only ever a CONFIRMED address: set from notifyEmailPending when the
  // confirmation link mailed to it is opened (modules/notifications.ts).
  // Null = no email notifications -- the account email is never mailed
  // (neither stack verifies it, and a bridged row's may be *.invalid).
  notifyEmail         String?
  notifyEmailVerifiedAt DateTime?
  // An address the creator asked for but hasn't confirmed, and the sha256
  // of the single-use confirmation token mailed to it.
  notifyEmailPending    String?
  notifyEmailTokenHash  String?   @unique
  notifyEmailTokenExpiresAt DateTime?
  // Last confirmation mail sent (resend cooldown) and last notification
  // mail sent (per-recipient rate limit, core/notify.ts).
  notifyConfirmSentAt   DateTime?
  notifyMailedAt        DateTime?
  // Creators can turn DM notification off. On by default: a creator who
  // does not know a fan messaged them does not reply, and the reply is the
  // product.
  notifyOnDm          Boolean   @default(true)
  // What a fan pays this creator to send them a message, in cents. The
  // creator sets it; PlatformConfig.minDmPriceCents is the floor and is
  // applied at send time, so lowering the floor later re-prices every
  // creator who sat on it without a migration. Null = use the floor.
  inboundDmPriceCents Int?
  avatarKey           String?
  bannerKey           String?
  tags                String[]  @default([]) // creator-picked discovery categories
  payoutAsset         Asset     @default(STABLE)
  payoutAddress       String?
  payoutsFrozen       Boolean   @default(false)
  promotedUntil       DateTime? // paid discovery placement

  // Token-lock perk: opt-in, creator sets the terms. A fan who locks
  // stakeUsdCents (worth of $ONLYONE at lock time) gets stakePerkDescription.
  // (It used to waive the 2% instant-payout fee too; that waiver was a free
  // toggle and was removed -- see modules/payouts.ts.)
  stakePerkEnabled     Boolean @default(false)
  stakePerkDescription String?
  stakeUsdCents        Int?

  tiers    SubscriptionTier[]
  posts    Post[]
  streams  LiveStream[]
  payouts  Payout[]
  listings Listing[]
}

model SubscriptionTier {
  id         String         @id @default(uuid())
  creatorId  String
  creator    CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  name       String
  priceCents Int
  active     Boolean        @default(true)
  subs       Subscription[]
}

model Subscription {
  id               String           @id @default(uuid())
  fanId            String
  fan              User             @relation("FanSubs", fields: [fanId], references: [id])
  creatorId        String
  creator          User             @relation("CreatorSubs", fields: [creatorId], references: [id])
  tierId           String
  tier             SubscriptionTier @relation(fields: [tierId], references: [id])
  priceCents       Int // locked at purchase
  status           SubStatus        @default(ACTIVE)
  autoRenew        Boolean          @default(true)
  currentPeriodEnd DateTime
  createdAt        DateTime         @default(now())

  @@unique([fanId, creatorId])
  @@index([status, currentPeriodEnd])
}

// Fan locks $ONLYONE-equivalent value against a creator's opted-in perk.
// Mirrors Subscription: monthly recurring charge, cancel = stop renewing.
model TokenLock {
  id                String    @id @default(uuid())
  fanId             String
  fan               User      @relation("FanLocks", fields: [fanId], references: [id])
  creatorId         String
  creator           User      @relation("CreatorLocks", fields: [creatorId], references: [id])
  usdCents          Int // locked at purchase, mirrors Subscription.priceCents
  tokenAmountAtLock String // $ONLYONE raw units this was worth at lock time (display only)
  status            SubStatus @default(ACTIVE)
  autoRenew         Boolean   @default(true)
  currentPeriodEnd  DateTime
  createdAt         DateTime  @default(now())

  @@unique([fanId, creatorId])
  @@index([status, currentPeriodEnd])
}

// onlyone.online marketplace: creators list something for sale (merch, digital
// goods, whatever), platform takes a 10% sale commission + 5% listing fee on
// top, both cut from the sale price when it sells (see modules/marketplace.ts).
// A listing a creator has put behind VIP first-look shows only to VIP members
// (and its creator) until vipEarlyUntil passes. Bites hardest on one-of-a-kind
// items, where missing the window means missing it for good.
model Listing {
  id                String         @id @default(uuid())
  creatorId         String
  creator           CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  title             String
  description       String         @default("")
  vipEarlyUntil     DateTime?
  priceCents        Int // FIXED: the price. AUCTION: the starting bid.
  unlimited         Boolean        @default(false) // true = digital good, sellable to many buyers; false = one-of-a-kind, SOLD after first purchase. Always false for AUCTION.
  kind              ListingKind    @default(DIGITAL)
  shippingCents     Int            @default(0) // flat fee the creator sets, physical only -- no address-based rate calculation
  signatureRequired Boolean        @default(false) // advisory only -- we don't integrate with any carrier, this just reminds the creator and tells the buyer. See MARKETPLACE_FULFILLMENT.md.
  images            String[]       @default([]) // free public preview photos (physical items)
  media             Media[] // the actual digital product, gated until purchased -- see core/access.ts canViewListing
  status            ListingStatus  @default(ACTIVE)
  createdAt         DateTime       @default(now())
  orders            ListingOrder[]

  // Auctions settle in the USD-backed balanceCents pool only, never the
  // $ONLYONE discount pool -- a bid needs a stable denomination for its
  // whole (possibly multi-day) run, and a token discount would make "highest
  // bid wins" ambiguous. See core/auctions.ts.
  saleType             SaleType  @default(FIXED)
  auctionEndsAt        DateTime?
  minBidIncrementCents Int? // null = use the default (greater of $1 or 5% of the current bid)
  reserveCents         Int? // hidden minimum; if unmet at close, the auction ends with no sale
  currentBidCents      Int?
  currentBidderId      String? // no FK -- transient/denormalized; Bid rows are the source of truth
  // What is actually held out of the leading bidder's balance right now: the
  // bid plus, for a PHYSICAL item, the shipping fee. Every release and the
  // settlement at close use THIS number, never one recomputed from the
  // listing, so a later edit to shipping/kind can never make the release or
  // the payout differ from what was taken. Null on rows from before it
  // existed, which held exactly currentBidCents.
  currentHoldCents     Int?
  // How much of currentHoldCents came out of the leader's WITHDRAWABLE
  // (earned) credits. Every release restores exactly this much as
  // withdrawable, so a creator bidding with money they earned and being
  // outbid does not have it turned into non-payable credits. Null = 0.
  currentHoldWithdrawableCents Int?
  bids                 Bid[]

  @@index([status, createdAt])
  @@index([saleType, status, auctionEndsAt])
}

// Every bid, kept even after being outbid, for history/audit. A bid's funds
// are held (AUCTION_BID_HOLD) the instant it's placed and released
// (AUCTION_BID_RELEASE) the instant it's outbid or the auction ends without
// a sale -- so by the time an auction closes, the winning bid is already
// real money, not a promise. See core/auctions.ts.
model Bid {
  id          String   @id @default(uuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  bidderId    String
  bidder      User     @relation(fields: [bidderId], references: [id])
  amountCents Int
  heldCents   Int? // bid + shipping actually held when this bid was placed (audit trail)
  heldWithdrawableCents Int? // the part of heldCents taken from withdrawable (earned) credits
  // The bidder's explicit 18+ marketplace confirmation and ToS acceptance,
  // given ON THIS BID. closeAuction copies the winning bid's values onto
  // the order; null on bids placed before the bid route required them.
  ageConfirmedAt DateTime?
  tosVersion     String?
  createdAt   DateTime @default(now())

  @@index([listingId, amountCents])
}

// The creator gets paid at purchase time, physical or digital -- no escrow.
// Shipping method (and whether to require a signature) is the creator's own
// call; ship status here is for buyer/creator visibility only, it never
// gates a payout. See MARKETPLACE_FULFILLMENT.md.
model ListingOrder {
  id               String   @id @default(uuid())
  listingId        String
  listing          Listing  @relation(fields: [listingId], references: [id])
  buyerId          String
  buyer            User     @relation(fields: [buyerId], references: [id])
  priceCents       Int // locked at purchase
  shippingCents    Int      @default(0) // locked at purchase, physical only
  platformFeeCents Int // 10% commission (on priceCents only, not shipping)
  listingFeeCents  Int // 5% listing fee (on priceCents only, not shipping)
  // Explicit 18+ marketplace confirmation, separate from account-level DOB
  // check. Nullable only for an auction won with a bid placed before bids
  // required it -- never filled in with a made-up time.
  ageConfirmedAt   DateTime?
  tosVersion       String?
  createdAt        DateTime @default(now())

  shipStatus     ShipStatus @default(DIGITAL)
  carrier        String?
  trackingNumber String?
  shippedAt      DateTime?

  @@index([shipStatus])
}

// A post a creator has put behind VIP early access shows only to VIP members
// (and the creator) until this passes, then behaves like any other post.
// Opt-in per post rather than platform-wide: making every post late for paying
// subscribers by default would be selling the same people their own patience.
model Post {
  id            String         @id @default(uuid())
  creatorId     String
  creator       CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  text          String         @default("")
  visibility    Visibility     @default(SUBSCRIBERS)
  priceCents    Int            @default(0)
  removed       Boolean        @default(false)
  vipEarlyUntil DateTime?
  createdAt     DateTime       @default(now())
  media         Media[]
  unlocks       PostUnlock[]

  @@index([creatorId, createdAt])
  @@index([vipEarlyUntil])
}

model PostUnlock {
  fanId  String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([fanId, postId])
}

model Media {
  id            String      @id @default(uuid())
  ownerId       String
  key           String      @unique // raw upload key
  hlsKey        String? // transcoded playlist key
  previewKey    String? // blurred thumbnail (public)
  mime          String
  bytes         Int         @default(0)
  status        MediaStatus @default(UPLOADING)
  postId        String?
  post          Post?       @relation(fields: [postId], references: [id], onDelete: SetNull)
  messageId     String?
  message       Message?    @relation(fields: [messageId], references: [id], onDelete: SetNull)
  listingId     String?
  listing       Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  // Set on the per-recipient copies a mass DM makes (workers/broadcast.ts).
  // A copy's own `key` is `<source key>#<messageId>` so the unique index
  // holds; the real storage object is the source's -- see core/media-key.ts.
  sourceMediaId String?
  createdAt     DateTime    @default(now())
  // When the row last entered PROCESSING (POST /media/:id/complete, or a
  // re-queue by the reconciler in core/transcode-reconcile.ts), and how many
  // times the reconciler has had to re-queue a lost/stalled transcode job.
  // Past the cap the media is REJECTED so a poison file cannot loop forever.
  processingSince   DateTime?
  transcodeRequeues Int         @default(0)

  @@index([sourceMediaId])
  @@index([status, processingSince])
  // Report queue: "does this message have REJECTED media" (core/reports.ts
  // listReports), and every takedown that selects a message's media.
  @@index([messageId])
}

model Conversation {
  id        String    @id @default(uuid())
  aId       String
  bId       String
  messages  Message[]
  updatedAt DateTime  @updatedAt

  @@unique([aId, bId])
}

model Message {
  id             String          @id @default(uuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  text           String          @default("")
  priceCents     Int             @default(0) // >0 = locked media
  // Which mass DM this message came from (workers/broadcast.ts). Unique per
  // conversation so a retried broadcast job skips fans it already reached
  // instead of sending (and charging for) the same drop twice.
  broadcastId    String?
  media          Media[]
  unlocks        MessageUnlock[]
  createdAt      DateTime        @default(now())

  @@unique([conversationId, broadcastId])
  @@index([conversationId, createdAt])
  // Every copy of one mass DM (sender + broadcastId): broadcast takedowns,
  // messageAndBroadcastSiblings, and the report queue (core/reports.ts).
  @@index([senderId, broadcastId])
}

model MessageUnlock {
  fanId     String
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([fanId, messageId])
}

// ---------- MONEY ----------

model Account {
  userId       String    @id
  user         User      @relation(fields: [userId], references: [id])
  balanceCents BigInt    @default(0)
  // Funded only by depositing in $ONLYONE directly (see deposit-indexer.ts).
  // No longer discounted just for spending from here -- see charge()/MEMORY.md.
  onlyOneCents BigInt    @default(0)
  // The part of balanceCents that may be paid out: credits EARNED from
  // someone else's spend (core/ledger.ts post(..., { earned: true })).
  // Deposited credits are closed-loop -- spendable here, never withdrawn.
  // A spend consumes the non-withdrawable part first; always
  // 0 <= withdrawableCents <= balanceCents.
  withdrawableCents BigInt @default(0)
  // VIP runs while this is in the future. A paid monthly membership, NOT a
  // one-time burn: decided 2026-09-18, replacing the earlier "burn tokens for
  // permanent VIP" design outright.
  //
  // The fan pays in credits and never touches a token or a wallet -- that
  // revenue is what buys $ONLYONE on the open market and burns it (see
  // TokenBurn below), which is a better demand engine than one-off fan burns
  // because it recurs every month whether or not anyone is paying attention.
  vipUntil     DateTime?
}

// Singleton row (id is always 1) for platform-wide numeric knobs that need to
// change without a redeploy.
model PlatformConfig {
  id              Int @id @default(1)
  // What VIP costs per month, in cents. $20 by default.
  vipPriceCents   Int @default(2000)
  // The floor on what a creator can charge a fan to send them a message.
  // Decided 2026-09-20: messaging a creator is never free. A creator can
  // price ABOVE this and many will; none can price below it or at zero.
  // The money is the creator's, less the standard 10%.
  minDmPriceCents Int @default(99)
  // What share of the platform's OWN revenue is committed to buying $ONLYONE
  // on the open market and burning it, in basis points.
  //
  // Every source counts, not just VIP: the 10% cut, the 2% on buying credits,
  // withdrawal fees, promotions, marketplace and auction fees. Money bound
  // for a creator is never touched -- this is only what the platform keeps,
  // which is the money that would otherwise just sit there.
  //
  // Default 2500 (a quarter). Deliberately not 100%: committing every cent of
  // revenue to burns leaves nothing to run the platform with, and a burn the
  // platform cannot afford stops happening, which is worse for holders than a
  // smaller one that always does.
  burnBps         Int @default(2500)
}

// Money committed to buying $ONLYONE on the open market and destroying it.
//
// Recorded the moment the revenue arrives, executed later by the token-burn
// worker, so an outage or a missing pool delays the burn instead of losing
// it. A row with no txHash is an obligation the platform still owes the
// supply -- which makes "how much have we actually burned" answerable from
// the database rather than from memory.
model TokenBurn {
  id           String    @id @default(uuid())
  usdCents     BigInt
  reason       String // "vip" -- what the money came from
  refId        String? // the charge it came from, for tracing
  createdAt    DateTime  @default(now())
  executedAt   DateTime?
  txHash       String? // the on-chain swap+burn, once done
  tokensBurned String? // raw units actually destroyed
  // The automatic burner's swap for this obligation, persisted BEFORE it is
  // broadcast (workers/token-burn.ts). While set, the obligation is in
  // flight: the next run settles it from the chain (success -> executed,
  // revert / provably dropped -> cleared) before it may start a new swap, so
  // a receipt timeout or restart never buys and burns the same money twice.
  pendingTxHash String?
  pendingNonce  Int?
  pendingSince  DateTime?

  @@index([executedAt])
  @@index([pendingTxHash])
}

model LedgerEntry {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountCents BigInt // signed
  type        TxType
  refId       String? // subscription/post/message/payout id
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model DepositAddress {
  id              String @id @default(uuid())
  userId          String
  user            User   @relation(fields: [userId], references: [id])
  chainId         Int
  address         String
  derivationIndex Int
  // Chain head when the address was handed out (null if the RPC could not be
  // asked). The deposit indexer's first run starts no later than the
  // earliest of these (workers/deposit-cursor.ts), never at the head.
  issuedBlock     BigInt?
  createdAt       DateTime @default(now())

  @@unique([chainId, address])
  @@unique([userId, chainId])
}

model Deposit {
  id           String    @id @default(uuid())
  userId       String
  chainId      Int
  txHash       String
  logIndex     Int
  asset        Asset
  // Which dollar stablecoin it actually was ("USDG"), for STABLE deposits.
  // Null for ETH and ONLYONE.
  stableSymbol String?
  rawAmount    String // wei / 6-dec units as string
  // What actually landed on-chain, BEFORE the buy-credits fee. Never
  // overwritten with the net: the gross is the only figure that can be
  // reconciled against the transaction.
  usdCents     BigInt
  // The buy-credits fee taken out of it (FEES.DEPOSIT_BPS).
  feeCents     BigInt    @default(0)
  priceUsed    Float
  createdAt    DateTime  @default(now())
  // How much of this deposit's hedge target has actually been sold, in raw
  // token units (workers/treasury-hedge.ts). A deposit larger than one
  // impact-capped swap is covered across several cycles; hedgedAt is set
  // only once this reaches the target.
  hedgedRaw    String    @default("0")
  hedgedAt     DateTime? // set once the treasury-hedge worker has converted this $ONLYONE deposit's share; null = pending. Unused for non-ONLYONE assets.
  // An ETH / $ONLYONE deposit that could not be priced when it was indexed.
  // Recorded (usdCents 0, nothing posted, not swept, hedgedAt set so the
  // hedge never sells it) so the indexer's cursor can move on; the deposit
  // indexer's reprice loop credits it once a price exists and clears this.
  pricePending Boolean   @default(false)

  @@unique([chainId, txHash, logIndex])
  @@index([pricePending])
}

// One row per auto-hedge swap the treasury worker executes: converts a slice of
// incoming $ONLYONE deposits into the stablecoin so the platform isn't fully
// exposed to $ONLYONE price swings on liabilities it owes in fixed USD cents.
model TreasuryHedgeBatch {
  id             String   @id @default(uuid())
  depositCount   Int
  onlyOneRawIn   String
  usdcRawOut     String
  priceImpactBps Int
  txHash         String
  // 'PENDING' from the moment the swap is signed (persisted before it is
  // broadcast) until the chain settles it: 'DONE' (deposits' hedgedRaw
  // advanced) or 'FAILED' (reverted / provably dropped, nothing sold). A
  // PENDING batch blocks the next swap, so a receipt timeout can never sell
  // the same deposits twice. Rows from before this column existed are DONE.
  status         String    @default("DONE")
  nonce          Int?
  resolvedAt     DateTime?
  createdAt      DateTime  @default(now())

  @@index([status])
}

model Payout {
  id          String         @id @default(uuid())
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [userId])
  asset       Asset
  address     String
  instant     Boolean        @default(false)
  amountCents BigInt // net of withdrawal fee
  feeCents    BigInt
  assetAmount String?
  priceUsed   Float?
  txHash      String?
  // The treasury nonce the signed transaction used, persisted with txHash so
  // a payout interrupted mid-flight can be settled later (the reconciler in
  // workers/payout-worker.ts proves a never-broadcast tx dead by nonce).
  nonce       Int?
  // When the worker signed txHash. The reconciler's automatic-refund window
  // is measured from this, not from createdAt (the REQUEST time -- a payout
  // held for days before signing was otherwise never auto-settled).
  signedAt    DateTime?
  // The worker's own zero-value nonce-cancel for txHash, persisted before it
  // is broadcast. A never-sent payout is only refunded automatically when
  // THIS transaction is what consumed the nonce -- a nonce consumed by
  // anything else (e.g. a hand-sent treasury transfer settling it) is left
  // for an admin, because that transfer may itself have paid the creator.
  cancelTxHash String?
  status      PayoutStatus   @default(PENDING)
  error       String?
  createdAt   DateTime       @default(now())
}

model ChainCursor {
  chainId   Int    @id
  lastBlock BigInt
}

// Paid-DM idempotency: one row per (sender, client requestId), inserted in
// the same transaction as the message and its DM_SEND charge
// (modules/messages.ts sendDirectMessage).
model DmSendRequest {
  senderId  String
  key       String // client-generated uuid, one per message the sender intends
  messageId String? // null only inside the send's own transaction: the row is claimed before the message exists
  createdAt DateTime @default(now())

  @@id([senderId, key])
}

// One row per tip request, keyed by the client's idempotency key: a retried
// or double-clicked POST /tips collides on the primary key inside the charge's
// transaction and gets the first request's result instead of paying again.
model TipRequest {
  fanId     String
  key       String // client-generated uuid, one per tip the fan intends
  tipId     String
  // What the key was used for, so a key reused for a different tip is
  // refused rather than answered "already sent". Null on rows from before.
  creatorId   String?
  amountCents Int?
  createdAt DateTime @default(now())

  @@id([fanId, key])
}

// ---------- LIVE ----------

model LiveStream {
  id               String         @id @default(uuid())
  creatorId        String
  creator          CreatorProfile @relation(fields: [creatorId], references: [userId])
  roomName         String         @unique
  title            String
  ticketPriceCents Int            @default(0) // 0 = subscribers only
  // Charged per minute watched, on top of (or instead of) the ticket. 0 = off.
  // Billed a minute at a time IN ADVANCE -- see LiveMinute.
  perMinuteCents   Int            @default(0)
  status           StreamStatus   @default(LIVE)
  startedAt        DateTime       @default(now())
  endedAt          DateTime?
  tickets          LiveTicket[]
  minutes          LiveMinute[]

  // At most one LIVE stream per creator: a partial unique index
  // ("LiveStream_one_live_per_creator", round-9 migration -- Prisma can't
  // express WHERE); core/live-sweep.ts startLiveStream also serializes on a
  // per-creator advisory lock.
  @@index([creatorId, status])
}

model LiveTicket {
  fanId    String
  streamId String
  stream   LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@id([fanId, streamId])
}

// One row per minute of a stream a fan has PAID FOR, written in the same
// transaction as the charge.
//
// The composite primary key is the whole anti-double-billing design: billing
// the same minute twice cannot be a race to lose, it is a primary key
// violation. A retried request, a double-tapped client, two tabs on the same
// stream -- all of them collide here and the loser's charge rolls back with
// its transaction. Nothing has to remember what was already billed.
//
// minuteIndex counts from the fan's first paid minute, not from wall-clock
// time, so a fan who joins late is never billed for minutes before they
// arrived.
model LiveMinute {
  fanId       String
  streamId    String
  minuteIndex Int
  stream      LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)
  paidCents   Int
  // The moment this viewer's paid time runs out after buying this minute:
  // max(now, previous paidThrough) + 60s. The latest row's value is what the
  // live sweep (core/live-sweep.ts) compares against to remove a viewer who
  // stopped paying. Null on rows from before it existed (read as createdAt+60s).
  paidThrough DateTime?
  createdAt   DateTime   @default(now())

  @@id([fanId, streamId, minuteIndex])
}

// ---------- MODERATION ----------

model Report {
  id         String       @id @default(uuid())
  reporterId String
  targetType String // "post" | "user" | "message" | "listing"
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  resolvedBy String?
  createdAt  DateTime     @default(now())
  // At most one OPEN report per (reporter, target): a partial unique index
  // in the round-4 migration (Prisma can't express WHERE); core/reports.ts
  // fileReport answers a collision with the existing report.

  // Reports on one target, any reporter and status: the report queue's
  // "already actioned" probe and the resolve route's related-report lookup.
  @@index([targetType, targetId, status])
}

// ---------- NOTIFICATIONS ----------

enum NotificationKind {
  DM_RECEIVED
}

// One row per thing a creator should know about.
//
// The ROW is the source of truth and email is only a delivery channel on
// top of it. That split is deliberate and load-bearing: this platform is in
// a category most mainstream email providers refuse to serve (Resend
// prohibits "Pornography/sexually explicit content" and "Escort services"
// outright), so the provider is the part most likely to be missing, to be
// swapped, or to terminate the account mid-flight. Recording first means
// the in-app inbox badge works with no provider at all, nothing is lost
// while email is off, and turning it on later does not need a backfill.
//
// emailedAt is null until a send actually succeeds -- NOT set optimistically
// when one is attempted, or a provider outage would look like a delivered
// notification forever.
model Notification {
  id        String           @id @default(uuid())
  userId    String
  user      User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      NotificationKind
  // Who caused it, for "X messaged you". Never the message body -- see
  // lib/mailer.ts for why content never leaves this system by email.
  actorId   String?
  refId     String?
  readAt    DateTime?
  emailedAt DateTime?
  createdAt DateTime         @default(now())

  @@index([userId, readAt])
  @@index([userId, createdAt])
}

// An address this platform must stop emailing, and why.
//
// This is the piece AWS explicitly asks about before granting SES
// production access ("how do you manage bounces, complaints, and
// unsubscribe requests"), and it is the one gap that made that question
// unanswerable honestly before now -- sendNotificationMail() had no way to
// know an address was dead or had complained, so it would try again next
// time regardless. SES suspends an account over bounce/complaint RATE
// (roughly 5% / 0.1%), so this is not paperwork, it is what keeps the
// account able to send at all.
//
// PERMANENT bounces and ANY complaint suppress on the first occurrence --
// a complaint means a real person marked this as spam, and sending again
// is the one guaranteed way to make the next review worse. TRANSIENT
// bounces (mailbox full, greylisted) do NOT suppress here; see
// lib/ses-webhook.ts for why treating those as permanent would silently
// stop notifying a creator over a Monday-morning full inbox.
model Suppression {
  email     String   @id
  reason    String // 'bounce' | 'complaint'
  detail    String? // SES's own bounce sub-type / complaint feedback type, kept for support tickets like this one
  createdAt DateTime @default(now())
}
