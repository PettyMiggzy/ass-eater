generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  FAN
  CREATOR
  ADMIN
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  BANNED
}

enum KycStatus {
  NONE
  PENDING
  APPROVED
  REJECTED
}

// STABLE/ETH are settlement assets fans deposit in; ONLYASS is the platform
// token, which is never a payment (see core/ledger.ts's Balance type).
//
// STABLE is deliberately not a specific ticker. Robinhood Chain's dollar
// stablecoin is USDG today, USDC has no contract there, and which dollar
// tokens exist on a chain changes. Every one of them is worth a dollar, so
// the ledger does not need to care which arrived -- it books cents. The
// symbol is kept on the Deposit row for the audit trail, and which contracts
// are accepted is configuration (lib/chain.ts STABLECOINS), not code.
enum Asset {
  STABLE
  ETH
  ONLYASS
}

enum TxType {
  DEPOSIT
  SUBSCRIPTION
  PPV
  TIP
  MESSAGE_UNLOCK
  LIVE_TICKET
  PAYOUT
  PAYOUT_REVERSAL
  PLATFORM_FEE
  REFERRAL
  ADJUSTMENT
  TOKEN_LOCK
  MARKETPLACE_SALE
  REFUND
  AUCTION_BID_HOLD
  AUCTION_BID_RELEASE
  TOKEN_BURN
}

enum SaleType {
  FIXED
  AUCTION
}

enum ListingKind {
  DIGITAL
  PHYSICAL
}

enum ShipStatus {
  DIGITAL              // instant -- unlocking the media IS delivery
  AWAITING_SHIPMENT
  SHIPPED
}

enum ListingStatus {
  ACTIVE
  SOLD
  REMOVED
}

enum SubStatus {
  ACTIVE
  CANCELLED
  EXPIRED
}

enum Visibility {
  PUBLIC
  SUBSCRIBERS
  PPV
}

enum MediaStatus {
  UPLOADING
  PROCESSING
  READY
  REJECTED
}

enum PayoutStatus {
  PENDING
  PROCESSING
  SENT
  FAILED
}

enum StreamStatus {
  LIVE
  ENDED
}

enum ReportStatus {
  OPEN
  ACTIONED
  DISMISSED
}

model User {
  id           String     @id @default(uuid())
  email        String     @unique
  username     String     @unique
  passwordHash String
  role         Role       @default(FAN)
  status       UserStatus @default(ACTIVE)
  dob          DateTime
  kycStatus    KycStatus  @default(NONE)
  kycRef       String? // provider applicant id (2257-adjacent record pointer)
  referredById String?
  referredBy   User?      @relation("Referral", fields: [referredById], references: [id])
  referrals    User[]     @relation("Referral")
  createdAt    DateTime   @default(now())

  creator        CreatorProfile?
  account        Account?
  ledger         LedgerEntry[]
  refreshTokens  RefreshToken[]
  depositAddrs   DepositAddress[]
  subsAsFan      Subscription[]   @relation("FanSubs")
  subsAsCreator  Subscription[]   @relation("CreatorSubs")
  locksAsFan     TokenLock[]      @relation("FanLocks")
  locksAsCreator TokenLock[]      @relation("CreatorLocks")
  purchases      ListingOrder[]
  bids           Bid[]
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash String   @unique
  expiresAt DateTime
}

model CreatorProfile {
  userId        String    @id
  user          User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  displayName   String
  bio           String    @default("")
  avatarKey     String?
  bannerKey     String?
  tags          String[]  @default([]) // creator-picked discovery categories
  payoutAsset   Asset     @default(STABLE)
  payoutAddress String?
  payoutsFrozen Boolean   @default(false)
  promotedUntil DateTime? // paid discovery placement

  // Token-lock perk: opt-in, creator sets the terms. A fan who locks
  // stakeUsdCents (worth of $ONLYASS at lock time) gets stakePerkDescription.
  // Opting in also waives the 2% instant-payout fee for this creator.
  stakePerkEnabled     Boolean @default(false)
  stakePerkDescription String?
  stakeUsdCents        Int?

  tiers    SubscriptionTier[]
  posts    Post[]
  streams  LiveStream[]
  payouts  Payout[]
  listings Listing[]
}

model SubscriptionTier {
  id         String         @id @default(uuid())
  creatorId  String
  creator    CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  name       String
  priceCents Int
  active     Boolean        @default(true)
  subs       Subscription[]
}

model Subscription {
  id               String           @id @default(uuid())
  fanId            String
  fan              User             @relation("FanSubs", fields: [fanId], references: [id])
  creatorId        String
  creator          User             @relation("CreatorSubs", fields: [creatorId], references: [id])
  tierId           String
  tier             SubscriptionTier @relation(fields: [tierId], references: [id])
  priceCents       Int // locked at purchase
  status           SubStatus        @default(ACTIVE)
  autoRenew        Boolean          @default(true)
  currentPeriodEnd DateTime
  createdAt        DateTime         @default(now())

  @@unique([fanId, creatorId])
  @@index([status, currentPeriodEnd])
}

// Fan locks $ONLYASS-equivalent value against a creator's opted-in perk.
// Mirrors Subscription: monthly recurring charge, cancel = stop renewing.
model TokenLock {
  id                String    @id @default(uuid())
  fanId             String
  fan               User      @relation("FanLocks", fields: [fanId], references: [id])
  creatorId         String
  creator           User      @relation("CreatorLocks", fields: [creatorId], references: [id])
  usdCents          Int // locked at purchase, mirrors Subscription.priceCents
  tokenAmountAtLock String // $ONLYASS raw units this was worth at lock time (display only)
  status            SubStatus @default(ACTIVE)
  autoRenew         Boolean   @default(true)
  currentPeriodEnd  DateTime
  createdAt         DateTime  @default(now())

  @@unique([fanId, creatorId])
  @@index([status, currentPeriodEnd])
}

// onlyass.online marketplace: creators list something for sale (merch, digital
// goods, whatever), platform takes a 10% sale commission + 5% listing fee on
// top, both cut from the sale price when it sells (see modules/marketplace.ts).
model Listing {
  id          String         @id @default(uuid())
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  title       String
  description String         @default("")
  priceCents  Int // FIXED: the price. AUCTION: the starting bid.
  unlimited   Boolean        @default(false) // true = digital good, sellable to many buyers; false = one-of-a-kind, SOLD after first purchase. Always false for AUCTION.
  kind        ListingKind    @default(DIGITAL)
  shippingCents Int          @default(0) // flat fee the creator sets, physical only -- no address-based rate calculation
  signatureRequired Boolean  @default(false) // advisory only -- we don't integrate with any carrier, this just reminds the creator and tells the buyer. See MARKETPLACE_FULFILLMENT.md.
  images      String[]       @default([]) // free public preview photos (physical items)
  media       Media[] // the actual digital product, gated until purchased -- see core/access.ts canViewListing
  status      ListingStatus  @default(ACTIVE)
  createdAt   DateTime       @default(now())
  orders      ListingOrder[]

  // Auctions settle in the USD-backed balanceCents pool only, never the
  // $ONLYASS discount pool -- a bid needs a stable denomination for its
  // whole (possibly multi-day) run, and a token discount would make "highest
  // bid wins" ambiguous. See core/auctions.ts.
  saleType             SaleType  @default(FIXED)
  auctionEndsAt        DateTime?
  minBidIncrementCents Int? // null = use the default (greater of $1 or 5% of the current bid)
  reserveCents         Int? // hidden minimum; if unmet at close, the auction ends with no sale
  currentBidCents      Int?
  currentBidderId      String? // no FK -- transient/denormalized; Bid rows are the source of truth
  bids                 Bid[]

  @@index([status, createdAt])
  @@index([saleType, status, auctionEndsAt])
}

// Every bid, kept even after being outbid, for history/audit. A bid's funds
// are held (AUCTION_BID_HOLD) the instant it's placed and released
// (AUCTION_BID_RELEASE) the instant it's outbid or the auction ends without
// a sale -- so by the time an auction closes, the winning bid is already
// real money, not a promise. See core/auctions.ts.
model Bid {
  id          String   @id @default(uuid())
  listingId   String
  listing     Listing  @relation(fields: [listingId], references: [id])
  bidderId    String
  bidder      User     @relation(fields: [bidderId], references: [id])
  amountCents Int
  createdAt   DateTime @default(now())

  @@index([listingId, amountCents])
}

// The creator gets paid at purchase time, physical or digital -- no escrow.
// Shipping method (and whether to require a signature) is the creator's own
// call; ship status here is for buyer/creator visibility only, it never
// gates a payout. See MARKETPLACE_FULFILLMENT.md.
model ListingOrder {
  id               String     @id @default(uuid())
  listingId        String
  listing          Listing    @relation(fields: [listingId], references: [id])
  buyerId          String
  buyer            User       @relation(fields: [buyerId], references: [id])
  priceCents       Int // locked at purchase
  shippingCents    Int        @default(0) // locked at purchase, physical only
  platformFeeCents Int // 10% commission (on priceCents only, not shipping)
  listingFeeCents  Int // 5% listing fee (on priceCents only, not shipping)
  ageConfirmedAt   DateTime // explicit 18+ marketplace confirmation, separate from account-level DOB check
  tosVersion       String
  createdAt        DateTime   @default(now())

  shipStatus       ShipStatus @default(DIGITAL)
  carrier          String?
  trackingNumber   String?
  shippedAt        DateTime?

  @@index([shipStatus])
}

model Post {
  id         String         @id @default(uuid())
  creatorId  String
  creator    CreatorProfile @relation(fields: [creatorId], references: [userId], onDelete: Cascade)
  text       String         @default("")
  visibility Visibility     @default(SUBSCRIBERS)
  priceCents Int            @default(0)
  removed    Boolean        @default(false)
  createdAt  DateTime       @default(now())
  media      Media[]
  unlocks    PostUnlock[]

  @@index([creatorId, createdAt])
}

model PostUnlock {
  fanId  String
  postId String
  post   Post   @relation(fields: [postId], references: [id], onDelete: Cascade)

  @@id([fanId, postId])
}

model Media {
  id         String      @id @default(uuid())
  ownerId    String
  key        String      @unique // raw upload key
  hlsKey     String? // transcoded playlist key
  previewKey String? // blurred thumbnail (public)
  mime       String
  bytes      Int         @default(0)
  status     MediaStatus @default(UPLOADING)
  postId     String?
  post       Post?       @relation(fields: [postId], references: [id], onDelete: SetNull)
  messageId  String?
  message    Message?    @relation(fields: [messageId], references: [id], onDelete: SetNull)
  listingId  String?
  listing    Listing?    @relation(fields: [listingId], references: [id], onDelete: SetNull)
  createdAt  DateTime    @default(now())
}

model Conversation {
  id        String    @id @default(uuid())
  aId       String
  bId       String
  messages  Message[]
  updatedAt DateTime  @updatedAt

  @@unique([aId, bId])
}

model Message {
  id             String          @id @default(uuid())
  conversationId String
  conversation   Conversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  senderId       String
  text           String          @default("")
  priceCents     Int             @default(0) // >0 = locked media
  media          Media[]
  unlocks        MessageUnlock[]
  createdAt      DateTime        @default(now())

  @@index([conversationId, createdAt])
}

model MessageUnlock {
  fanId     String
  messageId String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([fanId, messageId])
}

// ---------- MONEY ----------

model Account {
  userId       String @id
  user         User   @relation(fields: [userId], references: [id])
  balanceCents BigInt @default(0)
  // Funded only by depositing in $ONLYASS directly (see deposit-indexer.ts).
  // No longer discounted just for spending from here -- see charge()/MEMORY.md.
  onlyAssCents BigInt @default(0)
  // VIP runs while this is in the future. A paid monthly membership, NOT a
  // one-time burn: decided 2026-09-18, replacing the earlier "burn tokens for
  // permanent VIP" design outright.
  //
  // The fan pays in credits and never touches a token or a wallet -- that
  // revenue is what buys $ONLYONE on the open market and burns it (see
  // TokenBurn below), which is a better demand engine than one-off fan burns
  // because it recurs every month whether or not anyone is paying attention.
  vipUntil        DateTime?
}

// Singleton row (id is always 1) for platform-wide numeric knobs that need to
// change without a redeploy.
model PlatformConfig {
  id             Int @id @default(1)
  // What VIP costs per month, in cents. $20 by default.
  vipPriceCents  Int @default(2000)
  // What share of VIP revenue is spent buying $ONLYONE on the open market and
  // burning it, in basis points. 10000 = all of it.
  //
  // The whole point of charging in dollars rather than asking fans to burn
  // tokens themselves: a fan needs no wallet, and the buy still lands on the
  // open market where it moves the price, instead of the platform selling
  // tokens (which would cap the price at whatever it sold them for).
  vipBurnBps     Int @default(10000)
}

// Money committed to buying $ONLYONE on the open market and destroying it.
//
// Recorded the moment the revenue arrives, executed later by the token-burn
// worker, so an outage or a missing pool delays the burn instead of losing
// it. A row with no txHash is an obligation the platform still owes the
// supply -- which makes "how much have we actually burned" answerable from
// the database rather than from memory.
model TokenBurn {
  id          String    @id @default(uuid())
  usdCents    BigInt
  reason      String    // "vip" -- what the money came from
  refId       String?   // the charge it came from, for tracing
  createdAt   DateTime  @default(now())
  executedAt  DateTime?
  txHash      String?   // the on-chain swap+burn, once done
  tokensBurned String?  // raw units actually destroyed

  @@index([executedAt])
}

model LedgerEntry {
  id          String   @id @default(uuid())
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountCents BigInt // signed
  type        TxType
  refId       String? // subscription/post/message/payout id
  meta        Json?
  createdAt   DateTime @default(now())

  @@index([userId, createdAt])
  @@index([type, createdAt])
}

model DepositAddress {
  id              String @id @default(uuid())
  userId          String
  user            User   @relation(fields: [userId], references: [id])
  chainId         Int
  address         String
  derivationIndex Int

  @@unique([chainId, address])
  @@unique([userId, chainId])
}

model Deposit {
  id        String    @id @default(uuid())
  userId    String
  chainId   Int
  txHash    String
  logIndex  Int
  asset     Asset
  // Which dollar stablecoin it actually was ("USDG"), for STABLE deposits.
  // Null for ETH and ONLYASS.
  stableSymbol String?
  rawAmount String // wei / 6-dec units as string
  usdCents  BigInt
  priceUsed Float
  createdAt DateTime  @default(now())
  hedgedAt  DateTime? // set once the treasury-hedge worker has converted this $ONLYASS deposit's share; null = pending. Unused for non-ONLYASS assets.

  @@unique([chainId, txHash, logIndex])
}

// One row per auto-hedge swap the treasury worker executes: converts a slice of
// incoming $ONLYASS deposits into the stablecoin so the platform isn't fully
// exposed to $ONLYASS price swings on liabilities it owes in fixed USD cents.
model TreasuryHedgeBatch {
  id             String   @id @default(uuid())
  depositCount   Int
  onlyAssRawIn   String
  usdcRawOut     String
  priceImpactBps Int
  txHash         String
  createdAt      DateTime @default(now())
}

model Payout {
  id          String         @id @default(uuid())
  creatorId   String
  creator     CreatorProfile @relation(fields: [creatorId], references: [userId])
  asset       Asset
  address     String
  instant     Boolean        @default(false)
  amountCents BigInt // net of withdrawal fee
  feeCents    BigInt
  assetAmount String?
  priceUsed   Float?
  txHash      String?
  status      PayoutStatus   @default(PENDING)
  error       String?
  createdAt   DateTime       @default(now())
}

model ChainCursor {
  chainId   Int    @id
  lastBlock BigInt
}

// ---------- LIVE ----------

model LiveStream {
  id               String         @id @default(uuid())
  creatorId        String
  creator          CreatorProfile @relation(fields: [creatorId], references: [userId])
  roomName         String         @unique
  title            String
  ticketPriceCents Int            @default(0) // 0 = subscribers only
  status           StreamStatus   @default(LIVE)
  startedAt        DateTime       @default(now())
  endedAt          DateTime?
  tickets          LiveTicket[]
}

model LiveTicket {
  fanId    String
  streamId String
  stream   LiveStream @relation(fields: [streamId], references: [id], onDelete: Cascade)

  @@id([fanId, streamId])
}

// ---------- MODERATION ----------

model Report {
  id         String       @id @default(uuid())
  reporterId String
  targetType String // "post" | "user" | "message" | "stream"
  targetId   String
  reason     String
  status     ReportStatus @default(OPEN)
  resolvedBy String?
  createdAt  DateTime     @default(now())
}
