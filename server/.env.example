# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/onlyass"

# Redis for BullMQ job queues (renewals, payouts, transcoding, chain indexing)
REDIS_URL="redis://localhost:6379"

# Long random string used to sign session JWTs
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
WEB_ORIGIN="https://onlyass.example.com"

