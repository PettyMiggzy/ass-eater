# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/onlyass"

# Redis for BullMQ job queues (renewals, payouts, transcoding, chain indexing)
REDIS_URL="redis://localhost:6379"

# Long random string used to sign session JWTs
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
WEB_ORIGIN="https://onlyass.example.com"

# --- Chain (Robinhood Chain mainnet, chain id 4663) ---
CHAIN="robinhood"             # or "robinhood-testnet" for testing
RPC_URL="https://rpc.mainnet.chain.robinhood.com"
CONFIRMATIONS=12
INDEXER_INTERVAL_MS=6000
TRACK_NATIVE_ETH="false"      # native ETH deposit tracking only catches direct transfers, not internal calls

# Treasury wallet that sends payouts and receives swept deposits (KEEP SECRET)
TREASURY_PRIVATE_KEY=

# One HD mnemonic used to derive a unique deposit address per user (KEEP SECRET)
DEPOSIT_MNEMONIC=

# NOTE: bridging USDC onto Robinhood Chain delivers USDG (Paxos Global Dollar),
# not native USDC -- there is no native USDC contract on this chain. Confirm the
# exact USDG contract address on robinhoodchain.blockscout.com (or
# docs.robinhood.com/chain) before setting this. The ledger's "USDC" asset
# label refers to whatever stablecoin address you put here.
USDC_ADDRESS=
# $ONLYASS must be deployed on Robinhood Chain (or bridged in) -- it does not
# exist there by default. Set this once you've deployed/bridged it.
ONLYASS_TOKEN_ADDRESS=
ONLYASS_DECIMALS=18
ONLYASS_DEPOSIT_BONUS_BPS=0   # e.g. 500 = 5% bonus credit for depositing in $ONLYASS

# --- Price oracles ---
CHAINLINK_ETH_USD=            # Chainlink ETH/USD feed address on the target chain
ONLYASS_PRICE_OVERRIDE=       # set a fixed USD price pre-launch, before there's a liquidity pool
ONLYASS_POOL=                 # Uniswap V3 pool address, once live
ONLYASS_POOL_TOKEN0_DECIMALS=
ONLYASS_POOL_TOKEN1_DECIMALS=
ONLYASS_IS_TOKEN0="true"
ONLYASS_POOL_QUOTE="WETH"     # or "USDC"

# --- Treasury auto-hedge ---
# Fans can pay/deposit in $ONLYASS for a discount, but their balance is booked in
# fixed USD cents while the tokens backing it are volatile. This worker converts
# most of each new $ONLYASS deposit into the stablecoin right away and leaves the
# rest as intentional treasury exposure. It's a no-op until all three of these +
# the price-oracle vars above are set (i.e. until $ONLYASS has a live V3 pool).
UNISWAP_V3_ROUTER_ADDRESS=     # SwapRouter02 on the target chain -- verify on the chain's own explorer, don't guess
UNISWAP_V3_QUOTER_ADDRESS=     # QuoterV2 on the target chain
ONLYASS_POOL_FEE=3000          # V3 fee tier for the ONLYASS pool, in hundredths of a bip (3000 = 0.3%)
TREASURY_HEDGE_BPS=7500        # 75% of each new $ONLYASS deposit gets converted to stablecoin, 25% stays as token exposure
TREASURY_HEDGE_MAX_IMPACT_BPS=300  # skip/shrink a swap rather than move the pool price more than 3%
TREASURY_HEDGE_INTERVAL_MS=300000  # sweep pending deposits every 5 minutes, batched, instead of per-deposit

# --- KYC provider (Sumsub) ---
SUMSUB_BASE_URL="https://api.sumsub.com"
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL="creator-kyc"
SUMSUB_WEBHOOK_SECRET=

# --- Media storage (S3-compatible origin, e.g. Wasabi/Backblaze B2/MinIO) ---
S3_ENDPOINT=
S3_REGION="us-east-1"
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=

# --- Bunny CDN in front of the S3 origin, with Token Authentication enabled ---
BUNNY_CDN_HOST=
BUNNY_TOKEN_KEY=

# --- Live streaming (self-hosted LiveKit) ---
LIVEKIT_HOST=
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
