# Template for /opt/onlyone/server/.env -- the API and shared settings.
#
# Comments go on their OWN line. systemd's EnvironmentFile= does not strip a
# trailing '# ...' after a value -- it becomes part of the value (a number
# turns into NaN, an address into junk).
#
# Every name here is one the code actually reads (grep process.env in src/).
# The pre-rename names this file used to carry (ONLYASS_*, USDC_ADDRESS) do
# nothing; the API and workers log a warning at boot if any are still set.
#
# SIGNING SECRETS DO NOT GO IN THIS FILE. TREASURY_PRIVATE_KEY and
# DEPOSIT_MNEMONIC belong in /opt/onlyone/server/.env.workers, which only the
# workers unit loads (see the bottom of this file and deploy/DEPLOY.md). The
# API is internet-facing and never signs anything.

# The treasury wallet's PUBLIC address (never the key). The API uses it to
# check that a payout an admin marks as sent was really paid from the
# treasury (POST /admin/payouts/:id/resolve mark_sent refuses without it).
TREASURY_ADDRESS=""
# Optional, comma-separated: extra wallets whose $ONLYONE burns may close burn
# obligations (POST /admin/token-burns/record). The treasury always counts.
BURN_SENDER_ADDRESSES=""

# Postgres connection string
DATABASE_URL="postgresql://onlyone:password@localhost:5432/onlyone"

# Redis for BullMQ job queues (renewals, payouts, transcoding, chain indexing)
REDIS_URL="redis://localhost:6379"

# Long random string used to sign session JWTs (openssl rand -hex 32)
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
WEB_ORIGIN="https://www.joinonlyone.com"
# Links in notification emails point here.
SITE_URL="https://www.joinonlyone.com"
# This API's own public origin; notification-email confirmation links point here.
PUBLIC_API_URL="https://api.joinonlyone.com"

# --- Site -> API bridge (modules/auth.ts POST /auth/bridge) ---
# The SAME value as BRIDGE_SECRET in the Next.js site's Vercel env. Required:
# the site is the only signup/login path, and without it every bridged
# request is refused.
BRIDGE_SECRET=
# Native /auth/register and non-admin /auth/login are closed unless "true".
DIRECT_AUTH_ENABLED="false"
# Anonymous GETs are closed unless "true" (an owner decision).
API_ANONYMOUS_READS="false"

# --- Chain (Robinhood Chain mainnet, chain id 4663) ---
# "robinhood" (mainnet) or "robinhood-testnet" for testing
CHAIN="robinhood"
RPC_URL="https://rpc.mainnet.chain.robinhood.com"
CONFIRMATIONS=12
INDEXER_INTERVAL_MS=6000
# re-queue sweeps for deposit addresses still holding a stablecoin
SWEEP_RECONCILE_INTERVAL_MS=3600000
# retry pricing ETH/$ONLYONE deposits that were indexed while no price was available
DEPOSIT_REPRICE_INTERVAL_MS=600000
# native ETH deposit tracking only catches direct transfers, not internal calls
TRACK_NATIVE_ETH="false"

# Extended public key of m/44'/60'/0'/0 for the deposit mnemonic. The API
# derives each fan's deposit address from this and never holds the mnemonic.
# Generate it once on the box: sudo -u onlyone node dist/scripts/derive-deposit-xpub.js < /dev/tty
DEPOSIT_XPUB=
# First block the deposit indexer scans on its FIRST run, if any deposit
# address was handed out without a recorded issuance block (e.g. while
# RPC_URL was still a placeholder). Set it to a block at or before the first
# address issued; without it the indexer refuses to start rather than skip
# deposits made before it first ran. Not needed otherwise.
DEPOSIT_START_BLOCK=

# --- Accepted stablecoins ---
# Default (leave these commented out): USDG, the Global Dollar, at the
# canonical Robinhood Chain registry address 0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168,
# 6 decimals. Bridging USDC onto this chain delivers USDG -- there is no USDC
# contract here. Decimals are checked against the contract at worker startup.
#USDG_ADDRESS=0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168
#USDG_DECIMALS=6
# Or an explicit allowlist, first entry = the dollar payouts settle in:
#STABLECOINS="USDG:0x5fc5360D0400a0Fd4f2af552ADD042D716F1d168:6"

# --- $ONLYONE (live, deployed from the founder's launchpad -- NOT from this repo) ---
# The token is never a payment method. The address feeds the price oracle,
# the hedge and the burn.
ONLYONE_TOKEN_ADDRESS=0x2c34ED86552076715272056D021cEab6080F1Ab5
ONLYONE_DECIMALS=18
# The deposit indexer ignores $ONLYONE transfers unless this is "true":
# nothing in the ledger spends an $ONLYONE balance, and a token deposit that
# cannot be priced is only recorded (uncredited) for admin review.
INDEX_ONLYONE_DEPOSITS="false"
ONLYONE_DEPOSIT_BONUS_BPS=0

# --- Price oracles ---
# Chainlink ETH/USD feed on the target chain (needed for an ETH-quoted pool)
CHAINLINK_ETH_USD=
# fixed USD price; leave empty to read the live pool
ONLYONE_PRICE_OVERRIDE=
# "v4" (singleton PoolManager, read via extsload) or "v3" (pool is its own contract)
ONLYONE_POOL_VERSION="v4"
ONLYONE_POOL_TOKEN0_DECIMALS=
ONLYONE_POOL_TOKEN1_DECIMALS=
ONLYONE_IS_TOKEN0="true"
# "WETH" or "USDG" -- anything but WETH is treated as a $1 quote
ONLYONE_POOL_QUOTE="WETH"
# fee tier, hundredths of a bip (3000 = 0.3%)
ONLYONE_POOL_FEE=3000
# V3 only:
# the pool's own contract address
ONLYONE_POOL=
# V4 only:
# the chain's singleton PoolManager address
ONLYONE_V4_POOL_MANAGER=
# the pool's currency0 (numerically smaller address; 0x0 means native ETH)
ONLYONE_V4_CURRENCY0=
# the pool's currency1
ONLYONE_V4_CURRENCY1=
# confirm per pool
ONLYONE_V4_TICK_SPACING=60
ONLYONE_V4_HOOKS="0x0000000000000000000000000000000000000000"

# --- Treasury auto-hedge (workers/treasury-hedge.ts) ---
# Only acts on $ONLYONE deposits, which are only indexed with
# INDEX_ONLYONE_DEPOSITS=true. It swaps through a Uniswap V3 router only;
# $ONLYONE's live pool is V4, so it stays a no-op until ported.
# SwapRouter02 -- verify on the chain's own explorer, don't guess
UNISWAP_V3_ROUTER_ADDRESS=
# QuoterV2
UNISWAP_V3_QUOTER_ADDRESS=
TREASURY_HEDGE_BPS=7500
TREASURY_HEDGE_MAX_IMPACT_BPS=300
TREASURY_HEDGE_INTERVAL_MS=300000

# --- Token burns (workers/token-burn.ts) ---
# Manual by default: the founder burns and records it with
# POST /admin/token-burns/record. Automatic burning needs a V3 route
# (ONLYONE_POOL_VERSION="v3" + UNISWAP_V3_ROUTER_ADDRESS) and refuses to start
# against the V4 pool.
TOKEN_BURN_AUTOMATIC="false"
TOKEN_BURN_INTERVAL_MS=900000
TOKEN_BURN_MIN_CENTS=5000
TOKEN_BURN_MAX_SLIPPAGE_BPS=300

# --- Payouts (workers/payout-worker.ts) ---
# How long to wait before deciding a payout whose broadcast errored never
# reached the chain (it is only auto-refunded when that is provable).
PAYOUT_BROADCAST_SETTLE_MS=20000
# Treasury outflow limits the key-holding worker enforces from its OWN
# environment, never the database (which every process can write). A payout
# over PAYOUT_MAX_CENTS, or one that would push the rolling 24h total past
# PAYOUT_DAILY_MAX_CENTS, is HELD for an admin instead of signed. Cents.
PAYOUT_MAX_CENTS=500000
PAYOUT_DAILY_MAX_CENTS=2000000
# Deposit-sweep gas top-ups (workers/sweep-gas.ts): the ETH the treasury
# sends a deposit address so it can move an ERC-20 on. Counted in the same
# outflow journal; past this many GWEI in a rolling 24h, sweeps defer.
# Default 5000000 gwei = 0.005 ETH = 100 top-ups.
SWEEP_GAS_DAILY_MAX_GWEI=5000000
# ...and at most this many top-ups per deposit address in the same window, so
# one address cannot use up the platform-wide cap. (Balances under a dollar
# are never topped up: they wait for the next deposit to that address, and a
# stablecoin balance also for the hourly reconciler once it reaches a dollar.
# A sweep deferred by these caps, or an $ONLYONE sweep whose price cannot be
# read, is retried for about an hour and then re-queued by the hourly
# reconciler, which (with INDEX_ONLYONE_DEPOSITS=true) also covers any
# $ONLYONE left at an address with a credited $ONLYONE deposit.)
SWEEP_GAS_PER_ADDRESS_DAILY=3

# --- API watermarking (lib/watermark.ts) ---
# Per-viewer watermarks are generated in the API process; at most this many
# at once (1-4). The API unit's MemoryMax is sized for the default of 1.
WATERMARK_CONCURRENCY=1

# --- Timers ---
AUCTION_SWEEP_INTERVAL_MS=60000
LIVE_SWEEP_INTERVAL_MS=20000

# --- Email (Amazon SES) ---
# Off unless EMAIL_PROVIDER=ses. When on, EMAIL_FROM is required and AWS
# credentials must resolve -- startup fails without either, instead of
# starting and failing every send silently.
EMAIL_PROVIDER=
EMAIL_FROM=
AWS_REGION="us-east-1"
# This droplet is not on AWS (no instance role), so SES signs with these.
# A dedicated IAM user limited to ses:SendEmail on the EMAIL_FROM identity.
# Not the S3 keys below (S3_ACCESS_KEY / S3_SECRET_KEY), which SES does not read.
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
# SNS topic ARN(s) for SES bounce/complaint notifications, comma-separated.
# The webhook refuses every message while this is unset.
SES_SNS_TOPIC_ARNS=

# --- KYC provider (Sumsub) ---
SUMSUB_BASE_URL="https://api.sumsub.com"
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL="creator-kyc"
SUMSUB_WEBHOOK_SECRET=

# --- Media storage (S3-compatible origin, e.g. Wasabi/Backblaze B2/MinIO) ---
# Keep object versioning OFF: images are sanitized (EXIF/GPS stripped) by
# overwriting the upload in place, and a versioned bucket keeps the original.
S3_ENDPOINT=
S3_REGION="us-east-1"
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=

# --- Bunny CDN in front of the S3 origin, with Token Authentication enabled ---
BUNNY_CDN_HOST=
BUNNY_TOKEN_KEY=
# Account API key, used only to purge the edge cache on a media takedown.
BUNNY_API_KEY=

# --- Live streaming (LiveKit) ---
LIVEKIT_HOST=
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=

# =====================================================================
# /opt/onlyone/server/.env.workers  (a SEPARATE file, chmod 600, loaded
# only by onlyone-workers.service) -- never put these two in .env.
# Each comment on its OWN line, exactly as below: systemd keeps a trailing
# '# ...' as part of the value, and a key with one appended is unusable.
#
#   # the wallet that pays out and receives sweeps
#   TREASURY_PRIVATE_KEY=0x...
#   # derives every fan's deposit address
#   DEPOSIT_MNEMONIC="..."
#
# Generate both yourself, on the box or a machine you trust. Never paste
# them into a chat session.
# =====================================================================
