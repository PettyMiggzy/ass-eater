# Postgres connection string
DATABASE_URL="postgresql://user:password@localhost:5432/onlyass"

# Redis for BullMQ job queues (renewals, payouts, transcoding, chain indexing)
REDIS_URL="redis://localhost:6379"

# Long random string used to sign session JWTs
JWT_SECRET="change-me-to-a-long-random-string"

PORT=4000
WEB_ORIGIN="https://onlyass.example.com"

# --- Chain (Base mainnet by default) ---
CHAIN="base"                  # or "base-sepolia" for testing
RPC_URL=
CONFIRMATIONS=12
INDEXER_INTERVAL_MS=6000
TRACK_NATIVE_ETH="false"      # native ETH deposit tracking only catches direct transfers, not internal calls

# Treasury wallet that sends payouts and receives swept deposits (KEEP SECRET)
TREASURY_PRIVATE_KEY=

# One HD mnemonic used to derive a unique deposit address per user (KEEP SECRET)
DEPOSIT_MNEMONIC=

USDC_ADDRESS=
ONLYASS_TOKEN_ADDRESS=
ONLYASS_DECIMALS=18
ONLYASS_DEPOSIT_BONUS_BPS=0   # e.g. 500 = 5% bonus credit for depositing in $ONLYASS

# --- Price oracles ---
CHAINLINK_ETH_USD=            # Chainlink ETH/USD feed address on the target chain
ONLYASS_PRICE_OVERRIDE=       # set a fixed USD price pre-launch, before there's a liquidity pool
ONLYASS_POOL=                 # Uniswap V3 pool address, once live
ONLYASS_POOL_TOKEN0_DECIMALS=
ONLYASS_POOL_TOKEN1_DECIMALS=
ONLYASS_IS_TOKEN0="true"
ONLYASS_POOL_QUOTE="WETH"     # or "USDC"

# --- KYC provider (Sumsub) ---
SUMSUB_BASE_URL="https://api.sumsub.com"
SUMSUB_APP_TOKEN=
SUMSUB_SECRET_KEY=
SUMSUB_LEVEL="creator-kyc"
SUMSUB_WEBHOOK_SECRET=

# --- Media storage (S3-compatible origin, e.g. Wasabi/Backblaze B2/MinIO) ---
S3_ENDPOINT=
S3_REGION="us-east-1"
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_FORCE_PATH_STYLE=

# --- Bunny CDN in front of the S3 origin, with Token Authentication enabled ---
BUNNY_CDN_HOST=
BUNNY_TOKEN_KEY=

# --- Live streaming (self-hosted LiveKit) ---
LIVEKIT_HOST=
LIVEKIT_WS_URL=
LIVEKIT_API_KEY=
LIVEKIT_API_SECRET=
