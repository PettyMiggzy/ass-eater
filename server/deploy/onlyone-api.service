[Unit]
Description=OnlyOne API (Fastify)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=onlyone
WorkingDirectory=/opt/onlyone/server
# Deliberately NOT .env.workers: the internet-facing process never holds the
# treasury key or the deposit mnemonic (lib/chain.ts builds them lazily and
# only the workers use them).
EnvironmentFile=/opt/onlyone/server/.env
ExecStart=/usr/bin/node dist/index.js
Restart=on-failure
RestartSec=3
# Contain an overrun to this unit: the droplet has 2 GB shared with
# Postgres, Redis and the two worker units, and an API memory spike must get
# the API restarted, not get the kernel OOM killer to take Postgres. The one
# heavy thing this process does is per-viewer watermarking, which is bounded
# to fit well inside this (lib/watermark.ts: one generation at a time,
# downscaled to a 2560px long edge / 20M animated pixels).
MemoryHigh=550M
MemoryMax=750M
NoNewPrivileges=true
PrivateTmp=true
# The code and .env are read-only to this process whatever the file modes
# say (defence in depth for app-setup.sh's ownership lock): it cannot swap
# the code, the checkout or the /opt/onlyone/server symlink out from under
# the key-holding workers. Nothing here writes under /opt/onlyone; scratch
# files go to the private /tmp.
ReadOnlyPaths=/opt/onlyone

[Install]
WantedBy=multi-user.target
